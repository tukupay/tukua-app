# Mobile env
EXPO_PUBLIC_COMPAT_WEB_SESSION_KEY=bankgpt_session
EXPO_PUBLIC_TUKUPAY_API=https://test.api.tuku.money

# Web SPA WebViews (Chat / Register / Courses / Profile)
# Local: http://localhost:8080  |  Live: https://tukua.ai
EXPO_PUBLIC_WEB_URL=http://localhost:8080
EXPO_PUBLIC_TUKUA_WEB_URL=http://localhost:8080

# Desk Nest API
# Local-first (dev:all): LAN proxy :3255 → Electron :3251 — auto-started by `npm start`
#   EXPO_PUBLIC_DESK_API_URL=http://localhost:3255/api
# Staging verify (Redis / cloud parity / twnzlk) — use when not testing offline Desk:
#   EXPO_PUBLIC_DESK_API_URL=https://tukua-api-staging-production.up.railway.app/api
# Live phones (EAS / store):
#   EXPO_PUBLIC_DESK_API_URL=https://tukua.up.railway.app/api
# Manual proxy: npm run desk:proxy  |  skip: DESK_PROXY=0 npm start
EXPO_PUBLIC_DESK_API_URL=http://localhost:3255/api

# Desk SPA WebViews (teacher/admin/accounts modules) — NOT https://tukua.ai (Amplify marketing).
# Local dev: Desk Vite on :3250 (auto LAN rewrite in __DEV__ when unset).
#   EXPO_PUBLIC_DESK_WEB_URL=http://localhost:3250
# Optional hosted Desk staging (when deployed):
#   EXPO_PUBLIC_DESK_WEB_STAGING=https://desk-staging.tukua.ai
EXPO_PUBLIC_DESK_WEB_URL=http://localhost:3250

# Push (Expo + Nest /platform/notifications/push-token). No VAPID needed on device;
# Nest/edge FCM still needs FIREBASE_* service account on the server for fan-out.
