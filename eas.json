{
  "cli": {
    "version": ">= 20.2.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleDebug"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_COMPAT_WEB_SESSION_KEY": "bankgpt_session",
        "EXPO_PUBLIC_TUKUPAY_API": "https://test.api.tuku.money",
        "EXPO_PUBLIC_WEB_URL": "https://v2.tukua.ai",
        "EXPO_PUBLIC_TUKUA_WEB_URL": "https://v2.tukua.ai",
        "EXPO_PUBLIC_TUKUA_ENV": "staging",
        "EXPO_PUBLIC_DESK_API_URL": "https://tukua-api-staging-production.up.railway.app/api",
        "EXPO_PUBLIC_NEST_API_URL": "https://tukua-api-staging-production.up.railway.app/api",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_COMPAT_WEB_SESSION_KEY": "bankgpt_session",
        "EXPO_PUBLIC_TUKUPAY_API": "https://test.api.tuku.money",
        "EXPO_PUBLIC_WEB_URL": "https://v2.tukua.ai",
        "EXPO_PUBLIC_TUKUA_WEB_URL": "https://v2.tukua.ai",
        "EXPO_PUBLIC_TUKUA_ENV": "staging",
        "EXPO_PUBLIC_DESK_API_URL": "https://tukua-api-staging-production.up.railway.app/api",
        "EXPO_PUBLIC_NEST_API_URL": "https://tukua-api-staging-production.up.railway.app/api",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      },
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
