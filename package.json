{
  "name": "tukua",
  "version": "1.0.3",
  "main": "index.js",
  "scripts": {
    "start": "node scripts/start-dev.mjs",
    "start:expo": "expo start",
    "desk:proxy": "node scripts/desk-lan-proxy.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:android": "expo prebuild --platform android --clean",
    "build:apk": "npx --yes eas-cli@20.2.0 build --platform android --profile preview",
    "build:aab": "npx --yes eas-cli@20.2.0 build --platform android --profile production",
    "build:aab:ci": "npx --yes eas-cli@20.2.0 build --platform android --profile production --non-interactive",
    "build:apk:ci": "npx --yes eas-cli@20.2.0 build --platform android --profile preview --non-interactive",
    "build:all:ci": "npm run build:apk:ci && npm run build:aab:ci",
    "credentials:android": "npx --yes eas-cli@20.2.0 credentials -p android",
    "eas:login": "npx --yes eas-cli@20.2.0 login --browser",
    "eas:login:sso": "npx --yes eas-cli@20.2.0 login --sso",
    "eas:whoami": "npx --yes eas-cli@20.2.0 whoami",
    "eas:init": "npx --yes eas-cli@20.2.0 init",
    "build:apk:local": "expo run:android --variant release",
    "doctor": "npx expo-doctor",
    "generate:logos": "python scripts/generate-logos.py"
  },
  "dependencies": {
