{
  "expo": {
    "name": "Tukua",
    "slug": "tukua",
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./assets/images/icons/app-icon-1024.png",
    "scheme": "tukua",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFFFFF",
      "image": "./assets/images/logo/splash-bird.png",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.app.tukua",
      "associatedDomains": [
        "applinks:tukua.ai",
        "applinks:www.tukua.ai"
      ],
      "infoPlist": {
        "UIStatusBarHidden": true,
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSCameraUsageDescription": "Tukua needs camera access for ID photos, document capture, and KYC.",
        "NSPhotoLibraryUsageDescription": "Tukua needs photo library access to upload ID images and documents.",
        "NSPhotoLibraryAddUsageDescription": "Tukua may save captured ID photos to your library.",
        "NSMicrophoneUsageDescription": "Tukua needs microphone access for voice features.",
        "NSLocationWhenInUseUsageDescription": "Tukua uses your location for security on first login.",
        "NSFaceIDUsageDescription": "Tukua uses Face ID for quick secure login.",
        "NSUserNotificationsUsageDescription": "Tukua sends alerts for opportunities, courses, and account updates.",
        "NSContactsUsageDescription": "Tukua matches people from your contacts who are already on Tukua Connect."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icons/adaptive-foreground-1024.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.app.tukua",
      "googleServicesFile": "./google-services.json",
      "versionCode": 9,
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tukua.ai",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "www.tukua.ai",
              "pathPrefix": "/"
            },
            {
              "scheme": "tukua",
              "host": "*"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "androidStatusBar": {
      "hidden": true,
      "translucent": true,
      "backgroundColor": "#FFFFFF"
    },
    "web": {
      "favicon": "./assets/images/icons/favicon-48.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo/splash-bird.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-asset",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tukua uses your location for security on first login."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Tukua matches people from your contacts who are already on Tukua Connect."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Tukua needs camera access for ID photos, document capture, and KYC.",
          "microphonePermission": "Tukua needs microphone access for voice features.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Tukua needs microphone access for voice features."
        }
      ],
      "expo-document-picker",
      "expo-file-system",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icons/notification-96.png",
          "color": "#1F8B4C"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Tukua uses Face ID for quick secure login."
        }
      ],
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#FFFFFF",
          "barStyle": "dark"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Tukua needs camera access for ID photos, document capture, and KYC.",
          "photosPermission": "Tukua uses the system photo picker so you can choose an ID photo or document."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "blockedPermissions": [
              "android.permission.READ_MEDIA_IMAGES",
              "android.permission.READ_MEDIA_VIDEO",
              "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
              "android.permission.READ_EXTERNAL_STORAGE"
            ]
          }
        }
      ]
    ],
    "extra": {
      "expo-navigation-bar": {
        "backgroundColor": "#FFFFFF",
        "barStyle": "dark"
      },
      "eas": {
        "projectId": "b66a093d-df11-4fe9-95bd-a471769c2504"
      }
    },
    "owner": "tukupay"
  }
}
